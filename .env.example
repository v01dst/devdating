DATABASE_URL=postgresql+asyncpg://devdating:devdating@localhost:5432/devdating
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-a-long-random-value
ENVIRONMENT=local
# Optional LAN access (default is loopback-only). If you set DEVDATING_BIND_HOST=0.0.0.0
# in devdating.env, also set WEB_ORIGIN to the address you browse from, e.g.
# WEB_ORIGIN=http://192.168.1.20:3000
