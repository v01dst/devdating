#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/devdating.env" 2>/dev/null || true
if [[ ! -f "$ROOT/devdating.env" ]]; then
  cat > "$ROOT/devdating.env" <<ENV
DATABASE_URL=sqlite+aiosqlite:///$ROOT/devdating.db
REDIS_URL=memory://
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=local-development-secret
ENVIRONMENT=local
DEVDATING_MODE=native
DEVDATING_HOME=$ROOT
ENV
fi
export DATABASE_URL REDIS_URL ENVIRONMENT DEVDATING_MODE DEVDATING_HOME SESSION_SECRET
MODE="${DEVDATING_MODE:-native}"
PID_DIR="$ROOT/.run"
LOG_DIR="$ROOT/logs"
mkdir -p "$PID_DIR" "$LOG_DIR"

blue='\033[0;34m'; cyan='\033[0;36m'; purple='\033[1;35m'; green='\033[0;32m'; yellow='\033[1;33m'; red='\033[0;31m'; bold='\033[1m'; reset='\033[0m'
# Keep V8 heap bounded so `next build` / `npm rebuild next` do not SIGABRT on small-RAM hosts.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=${DEVDATING_NODE_HEAP:-1536}}"
usage() {
  cat <<HELP
DevDating control plane

Usage:
  devdating <command>

Commands:
  install [--mode docker|native]   Install dependencies and initialize data
  setup-ui                         Launch the polished local installer UI
  up [--seed]                      Start API and web services
  upd [--mode docker|native]       Pull source, upgrade packages, migrate, restart
  down                             Stop services
  status                           Show service state
  logs [api|web]                   Tail service logs
  seed                             Load demo projects and developer profile
  open-setup                       Print the setup URL
  doctor                           Check prerequisites
  uninstall                        Stop services and remove generated files
HELP
}

running() { [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null; }
ensure_schema() {
  (cd api && "$ROOT/.venv/bin/alembic" upgrade head) >/dev/null 2>&1 || true
}
# Refuse to start when the port already answers but the answering process is not
# ours (e.g. a stale next-server from an earlier context). Returns 0 when clear.
ensure_port_clear() {
  local url="$1" name="$2" pidfile="$3"
  if curl -fsS --max-time 2 "$url" >/dev/null 2>&1 && ! running "$pidfile"; then
    local holder
    holder="$(cat "$pidfile" 2>/dev/null || echo '?')"
    printf "${red}✖${reset} $name port is held by another process (last known pid $holder).\n"
    printf "${yellow}▸${reset} Stop it (e.g. \`devdating down\` or kill the process) and retry.\n"
    return 1
  fi
  return 0
}
wait_for() {
  local url="$1" name="$2" pidfile="${3:-}" pid=""
  [[ -n "$pidfile" && -f "$pidfile" ]] && pid="$(cat "$pidfile")"
  for _ in $(seq 1 90); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
        printf "${red}✖${reset} $name process died (port likely taken by another process). Stop it and retry.\n"; return 1
      fi
      printf "${green}✔${reset} $name ready\n"; return 0
    fi
    sleep 1
  done
  printf "${red}✖${reset} $name failed to become ready\n"; return 1
}

PY_DEPS=(
  "fastapi>=0.111,<0.116"
  "uvicorn[standard]>=0.30,<0.31"
  "sqlalchemy[asyncio]>=2,<3"
  "aiosqlite>=0.19"
  "pydantic>=2,<3"
  "pydantic-settings>=2"
  "httpx>=0.27,<1"
  "itsdangerous>=2.2,<3"
  "alembic>=1.13,<2"
  "python-socketio>=5.16,<6"
)

python_deps() {
  printf "${cyan}▸${reset} Installing Python packages\n"
  python3 -m venv .venv
  . .venv/bin/activate
  pip install --upgrade pip >/dev/null
  pip install --upgrade "${PY_DEPS[@]}" >/dev/null
}

web_deps() {
  printf "${cyan}▸${reset} Installing web packages\n"
  (
    cd web
    npm install --no-audit --no-fund --legacy-peer-deps --loglevel=error
    npm update --no-audit --no-fund --legacy-peer-deps --loglevel=error
    if ! npm rebuild next --no-audit --no-fund --loglevel=error; then
      printf "${red}✖${reset} 'npm rebuild next' failed (low memory?). Retrying with a smaller heap.\n"
      NODE_OPTIONS="--max-old-space-size=768" npm rebuild next --no-audit --no-fund --loglevel=error
    fi
  )
}

install_native() {
  python_deps
  web_deps
}

case "${1:-help}" in
  install)
    shift || true
    mode="$MODE"
    while (($#)); do case "$1" in --mode) mode="$2"; shift 2;; *) shift;; esac; done
    if [[ "$mode" == docker ]]; then
      command -v docker >/dev/null && docker compose up --build -d || exit 1
    else
      install_native
      (cd api && "$ROOT/.venv/bin/alembic" upgrade head) || {
        printf "${yellow}▸${reset} Migration failed on an existing database. If tables predate migrations run:\n"
        printf "  cd api && ../.venv/bin/alembic stamp a58003a00ec6 && ../.venv/bin/alembic upgrade head\n"
        exit 1
      }
    fi
    ;;
  setup-ui)
    . .venv/bin/activate 2>/dev/null || true
    export DEVDATING_UI_ONLY=1
    exec uvicorn installer_ui.app:app --host 127.0.0.1 --port 3100
    ;;
  up)
    shift || true; seed=false
    for arg in "$@"; do [[ "$arg" == "--seed" ]] && seed=true; done
    if [[ "$MODE" == docker ]]; then docker compose up -d; else
      [[ -d .venv ]] || "$0" install
    . .venv/bin/activate
    export PYTHONPATH="$ROOT/api:${PYTHONPATH:-}"
      ensure_port_clear http://localhost:8000/healthz API "$PID_DIR/api.pid" || exit 1
      if running "$PID_DIR/api.pid"; then
        printf "${yellow}▸${reset} API already running\n"
      else
        (
          cd api
          set -a
          source "$ROOT/devdating.env"
          set +a
          nohup "$ROOT/.venv/bin/uvicorn" app.asgi:application --host 0.0.0.0 --port 8000 >"$ROOT/logs/api.log" 2>&1 &
          echo $! >"$ROOT/.run/api.pid"
        )
        wait_for http://localhost:8000/healthz API "$PID_DIR/api.pid" || exit 1
      fi
      ensure_port_clear http://localhost:3000 Web "$PID_DIR/web.pid" || exit 1
      if running "$PID_DIR/web.pid"; then
        printf "${yellow}▸${reset} Web already running\n"
      else
        (
          cd web
          if [[ ! -f .next/BUILD_ID ]]; then
            echo "Building web app before first launch..." >"$ROOT/logs/web.log"
            ./node_modules/.bin/next build >>"$ROOT/logs/web.log" 2>&1 || npm run build >>"$ROOT/logs/web.log" 2>&1 || {
              printf "${red}✖${reset} Web build failed. Last log lines:\n"
              tail -n 15 "$ROOT/logs/web.log" || true
              printf "${yellow}▸${reset} Hint: free RAM or lower the heap: DEVDATING_NODE_HEAP=768 devdating up\n"
              exit 1
            }
          fi
          nohup ./node_modules/.bin/next start --hostname 0.0.0.0 --port 3000 >>"$ROOT/logs/web.log" 2>&1 &
          echo $! >"$ROOT/.run/web.pid"
        )
        wait_for http://localhost:3000 Web "$PID_DIR/web.pid" || exit 1
      fi
      [[ "$seed" == true ]] && "$0" seed
      echo "Services started. Use \`devdating serve\` for attached production mode."
    fi
    ;;
  serve)
    if [[ ! -f web/.next/BUILD_ID ]]; then (cd web && npm run build); fi
    exec "$ROOT/bin/devdating-serve"
    ;;
  down|stop)
    if [[ "$MODE" == docker ]]; then docker compose down; else
      for service in web api; do file="$PID_DIR/$service.pid"; if running "$file"; then kill "$(cat "$file")"; rm -f "$file"; printf "${green}✔${reset} $service stopped\n"; fi; done
    fi ;;
  restart) "$0" down || true; sleep 1; "$0" up ;;
  status)
    for service in api web; do
      pidfile="$PID_DIR/$service.pid"
      if running "$pidfile"; then printf "${green}●${reset} %-4s running (PID %s)\n" "$service" "$(cat "$pidfile")"; else printf "${yellow}○${reset} %-4s stopped\n" "$service"; fi
    done ;;
  logs)
    service="${2:-all}"
    [[ "$service" != web ]] && tail -n 80 -f "$LOG_DIR/api.log"
    [[ "$service" != api ]] && tail -n 80 -f "$LOG_DIR/web.log"
    ;;
  seed)
    . .venv/bin/activate 2>/dev/null || true
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    ensure_schema
    python3 scripts/seed_local.py ;;
  open-setup) echo http://localhost:3100/setup ;;
  sync-github)
    shift || true
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    . .venv/bin/activate
    ensure_schema
    python scripts/sync_live.py "$@" ;;
  sync-me)
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    . .venv/bin/activate
    ensure_schema
    python scripts/sync_personal.py ;;
  sync-questions)
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    . .venv/bin/activate
    ensure_schema
    python scripts/sync_questions.py ;;
  sync-bulk)
    shift || true
    target="${1:-500}"
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    . .venv/bin/activate
    ensure_schema
    python scripts/bulk_sync.py "$target" ;;
  enrich-languages)
    export PYTHONPATH="$ROOT/api${PYTHONPATH:+:$PYTHONPATH}"
    . .venv/bin/activate
    ensure_schema
    python scripts/enrich_projects.py ;;
  doctor)
    command -v python3 >/dev/null && echo Python OK || exit 1
    command -v node >/dev/null && echo Node OK || exit 1
    command -v npm >/dev/null && echo npm OK || exit 1 ;;
  upd|update)
    shift || true
    mode="$MODE"
    while (($#)); do case "$1" in --mode) mode="$2"; shift 2;; *) shift;; esac; done
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf "${cyan}▸${reset} Pulling latest source\n"
      git pull --ff-only >/dev/null 2>&1 \
        && printf "${green}✔${reset} Source up to date\n" \
        || printf "${yellow}▸${reset} Could not fast-forward (local commits/changes). Updating packages only.\n"
    fi
    if [[ "$mode" == docker ]]; then
      command -v docker >/dev/null || exit 1
      docker compose pull
      docker compose up --build -d
      exit $?
    fi
    [[ -d .venv ]] || "$0" install
    python_deps
    web_deps
    printf "${cyan}▸${reset} Applying database migrations\n"
    (cd api && "$ROOT/.venv/bin/alembic" upgrade head) || {
      printf "${yellow}▸${reset} Migration failed. If this DB predates migrations run:\n"
      printf "  cd api && ../.venv/bin/alembic stamp a58003a00ec6 && ../.venv/bin/alembic upgrade head\n"
      exit 1
    }
    rm -f web/.next/BUILD_ID
    if running "$PID_DIR/api.pid" || running "$PID_DIR/web.pid"; then
      printf "${cyan}▸${reset} Restarting services with updated packages\n"
      "$0" down
      "$0" up
    else
      printf "${green}✔${reset} Packages updated. Run \`devdating up\` to start (web rebuilds on first launch).\n"
    fi
    ;;
  uninstall)
    "$0" down || true ;;
  help|--help|-h|*) usage ;;
esac
